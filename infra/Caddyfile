{$CHATWOOT_HOST} {
	# 1ª configuração (cria o super admin) e o painel super admin só por túnel SSH (porta 3000 no localhost da VPS)
	@restrito path /installation/* /super_admin*
	respond @restrito 404
	reverse_proxy chatwoot:3000
}

{$PAINEL_HOST} {
	# /hooks/* (webhook interno) e /health (consulta o banco) não são públicos
	@interno path /hooks/* /health
	respond @interno 404
	reverse_proxy api:8080
}
