# Copie para .env e preencha. Nunca commite o .env.
DOMAIN=localhost                 # VPS: seu domínio (Caddy emite TLS automático)
CHATWOOT_HOST=chat.localhost     # VPS: chat.seudominio.com.br
PAINEL_HOST=painel.localhost     # VPS: painel.seudominio.com.br

# TODAS as senhas/segredos em HEX (vão dentro de URLs): openssl rand -hex 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=
BRAIN_DB_PASSWORD=

# Chatwoot: gere com `openssl rand -hex 64`
CHATWOOT_SECRET_KEY_BASE=
# SMTP opcional (notificações por e-mail do Chatwoot)
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# App (brain). MASTER_KEY: `openssl rand -hex 32` — guarde um backup FORA da VPS.
MASTER_KEY=
# Segredo no path do webhook Chatwoot -> app: `openssl rand -hex 24`
WEBHOOK_SECRET=
# Token de acesso do Agent Bot no Chatwoot (Configurações > Bots) — preenchido no F1
CHATWOOT_BOT_TOKEN=
# Token de um usuário admin (só para atribuir, labels, notas privadas) — preenchido no F1
CHATWOOT_ADMIN_TOKEN=

# LLM (D2: modelo de produção ainda não escolhido; dev só com dados anonimizados)
LLM_BASE_URL=http://host.docker.internal:20128/v1
LLM_MODEL=
LLM_API_KEY=
LLM_APPROVED_FOR_PRODUCTION=false

# Evolution (somente com docker-compose.qr.yml)
EVOLUTION_API_KEY=
EVOLUTION_DB_PASSWORD=
