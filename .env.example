# Copie para .env e preencha. Nunca commite o .env.
DOMAIN=localhost                 # VPS: seu domínio (Caddy emite TLS automático)
CHATWOOT_HOST=chat.localhost     # VPS: chat.seudominio.com.br
PAINEL_HOST=painel.localhost     # VPS: painel.seudominio.com.br

# TODAS as senhas/segredos em HEX (vão dentro de URLs): openssl rand -hex 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=
BRAIN_DB_PASSWORD=

# Chatwoot: gere com `openssl rand -hex 64`
CHATWOOT_SECRET_KEY_BASE=
# SMTP opcional (notificações por e-mail do Chatwoot)
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# App (brain). MASTER_KEY: `openssl rand -hex 32` — guarde um backup FORA da VPS.
MASTER_KEY=
# Segredo no path do webhook Chatwoot -> app: `openssl rand -hex 24`
WEBHOOK_SECRET=
# Token de acesso do Agent Bot no Chatwoot (Configurações > Bots) — preenchido no F1
CHATWOOT_BOT_TOKEN=
# Token de um usuário admin (só para atribuir, labels, notas privadas) — preenchido no F1
CHATWOOT_ADMIN_TOKEN=

# LLM (D2: modelo de produção ainda não escolhido; dev só com dados anonimizados)
LLM_BASE_URL=http://host.docker.internal:20128/v1
LLM_MODEL=
LLM_API_KEY=
LLM_APPROVED_FOR_PRODUCTION=false
# Só entra quando o principal responde 429. Vazio = sem fallback. Grátis (Groq, Gemini free, Ollama).
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=

# true = cria o tenant demo, usuários e produtos de exemplo na subida (idempotente)
SEED_DEMO=true

# Ping do worker (T10). healthchecks.io grátis. Vazio = não pinga.
HEALTHCHECK_URL=

# Evolution (somente com docker-compose.qr.yml). A mesma instância manda o alerta do gestor (T9).
EVOLUTION_API_KEY=
EVOLUTION_DB_PASSWORD=
EVOLUTION_URL=http://evolution:8080
EVOLUTION_INSTANCE=
# WhatsApp do gestor, com DDI. Vazio = sem alerta fora do Chatwoot. Nunca um número de cliente.
GESTOR_WHATSAPP=

# false (padrão): transbordo atribui ao Lorenzo, com nota e prioridade, e a Malu continua.
# true: volta a pausar e a colocar a etiqueta ia-pausada.
IA_PAUSAR_NO_TRANSBORDO=false
# false trava a IA desligada em todas as conversas. true ou vazio: o painel (porta 8081) liga e desliga sem reiniciar.
IA_ATIVA=true
# Vazio = qualquer conversa individual. Preenchida (E.164, separados por vírgula) = a IA só responde esses números.
# Grupo (@g.us), status e broadcast são ignorados sempre, com ou sem a lista.
IA_ALLOWLIST=
